# For local development, omit database fields to use the ignored .data/orders.json store.
# For Hostinger Node.js hosting, use the database details from hPanel.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=munchy_store
DB_USER=munchy_app
DB_PASSWORD=replace-with-a-strong-password

# Required in production. Keep these server-side; never prefix with NEXT_PUBLIC_.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-random-64-character-secret

# Optional. Enter the actual WhatsApp business number in international format, digits only.
MUNCHY_WHATSAPP_NUMBER=

# Your actual HTTPS origin. Keep BUSINESS_VERIFIED=0 while content is a demo.
SITE_URL=
BUSINESS_VERIFIED=0
