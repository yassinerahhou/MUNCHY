# For local development, omit database fields to use the ignored .data/orders.json store.
# For Hostinger Node.js hosting, use the database details from hPanel.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=munchy_store
DB_USER=munchy_app
DB_PASSWORD=replace-with-a-strong-password

# Required in production. Keep these server-side; never prefix with NEXT_PUBLIC_.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-a-random-64-character-secret

# Optional. Enter the actual WhatsApp business number in international format, digits only.
MUNCHY_WHATSAPP_NUMBER=

# Your actual HTTPS origin. Keep BUSINESS_VERIFIED=0 while content is a demo.
SITE_URL=
BUSINESS_VERIFIED=0

# Optional real delivery geofence. Leave coordinates blank for manual kitchen confirmation.
NEXT_PUBLIC_KITCHEN_LAT=
NEXT_PUBLIC_KITCHEN_LNG=
NEXT_PUBLIC_DELIVERY_RADIUS_KM=5
NEXT_PUBLIC_DELIVERY_PER_KM=0

# Optional real Google reviews. API key stays server-side; Google may charge API fees.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Optional agency portfolio. Blank uses the local case-study page.
NEXT_PUBLIC_AGENCY_URL=

# Optional POS receiver. Receiver must verify HMAC and deduplicate by order code.
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=
